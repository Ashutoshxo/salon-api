# Server
PORT=3000
NODE_ENV=development

# MongoDB
MONGODB_URI=your_mongodb_connection_string_here

# Hugging Face
HUGGINGFACE_API_KEY=your_huggingface_api_key_here
MODEL_IMAGE_GEN=black-forest-labs/FLUX.1-dev

# Groq Text Generation
GROQ_API_KEY=your_groq_api_key_here
MODEL_TEXT_GEN=llama-3.3-70b-versatile

# Translation Models
MODEL_TRANSLATION_HI=Helsinki-NLP/opus-mt-hi-en
MODEL_TRANSLATION_MR=Helsinki-NLP/opus-mt-en-hi

# Speech-to-Text
MODEL_SPEECH_TO_TEXT=openai/whisper-large-v3

# Logging
LOG_LEVEL=info

# File Upload Limits
MAX_FILE_SIZE=10485760
MAX_AUDIO_SIZE=26214400

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100
